<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShootDrop.App.App"
             Name="ShootDrop"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ShootDrop/Styles/Theme.axaml" />
  </Application.Styles>
  <!-- The menu bar icon and its menu are built in code: Services/BackgroundController.cs -->
</Application>
