<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShootDrop.App.ViewModels"
        x:Class="ShootDrop.App.Views.ReadyWindow"
        x:DataType="vm:ReadyViewModel"
        Title="ShootDrop"
        Width="440" Height="620" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">

      <StackPanel Spacing="6">
        <TextBlock Text="Ready to copy" FontSize="22" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Setup" VerticalAlignment="Center" Opacity="0.75" />
          <ComboBox ItemsSource="{Binding SetupNames}" SelectedItem="{Binding SelectedSetup}" MinWidth="200" />
        </StackPanel>
      </StackPanel>

      <Border BorderBrush="#DCDDE0" BorderThickness="1" CornerRadius="10" Padding="4">
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CardRow">
              <Grid ColumnDefinitions="*,Auto" Margin="10,8">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Device}" FontSize="12" Opacity="0.7" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Stat}" VerticalAlignment="Center" FontSize="13" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="{Binding Summary}" Opacity="0.8" TextWrapping="Wrap" />

      <StackPanel Spacing="4">
        <TextBlock Text="Project name" FontSize="12" FontWeight="SemiBold" Opacity="0.75" />
        <TextBox Text="{Binding ProjectName}" />
      </StackPanel>

      <Button Command="{Binding CopyNowCommand}" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Height="52" FontSize="17" FontWeight="SemiBold"
              Classes="accent" Content="Copy now" />

      <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" IsVisible="{Binding IsCopying}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsCopying}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
