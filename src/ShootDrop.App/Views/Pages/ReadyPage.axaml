<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShootDrop.App.ViewModels"
             xmlns:sys="using:System"
             x:Class="ShootDrop.App.Views.Pages.ReadyPage"
             x:DataType="vm:ReadyPageViewModel">

  <ScrollViewer>
    <StackPanel Margin="22,20,22,22" Spacing="16">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="8">
          <TextBlock Classes="h1" Text="Ready to copy" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" Text="Setup" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SetupNames}" SelectedItem="{Binding SelectedSetup}" MinWidth="200" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Classes="link" Content="Settings" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Top" />
      </Grid>

      <Border Classes="card" Padding="0">
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CardRow">
              <Border BorderBrush="{StaticResource SoftLine}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid ColumnDefinitions="26,*,Auto">
                  <TextBlock Classes="good" Text="✓" FontSize="16" IsVisible="{Binding Included}" VerticalAlignment="Center" />
                  <TextBlock Text="–" Foreground="#B9BCC2" FontSize="16" IsVisible="{Binding Excluded}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Classes="name" Text="{Binding Name}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Device}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Stat}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <ItemsControl ItemsSource="{Binding Pills}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sys:String">
            <Border Classes="pill"><TextBlock Text="{Binding}" FontSize="13" /></Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="4">
        <TextBlock Classes="label" Text="Project name" Margin="0" />
        <TextBox Text="{Binding ProjectName}" />
      </StackPanel>

      <Button Classes="primary big" HorizontalAlignment="Stretch" Command="{Binding CopyNowCommand}" Content="{Binding ButtonText}" />

      <Border Classes="warn" IsVisible="{Binding HasStatus}">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="13" />
      </Border>

      <Grid ColumnDefinitions="Auto,*">
        <Button Classes="link" Content="More options…" Command="{Binding MoreOptionsCommand}" />
        <TextBlock Grid.Column="1" Classes="muted" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Text="Cards are only read. Nothing is overwritten." />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
