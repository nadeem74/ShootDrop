<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Icon of ShootDrop.exe on Windows -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>ShootDrop</AssemblyName>
    <RootNamespace>ShootDrop.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShootDrop.Core\ShootDrop.Core.csproj" />
    <ProjectReference Include="..\ShootDrop.Platform.Mac\ShootDrop.Platform.Mac.csproj" />
  </ItemGroup>

</Project>
